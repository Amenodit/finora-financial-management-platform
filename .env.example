# ==============================================================================
# Financial Management Platform — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env itself.
# ==============================================================================

# --- Core Django ---
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
POSTGRES_DB=finance_app_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Field-level encryption (for account numbers, phone, DOB) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# --- Email (password reset, notifications) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# --- File storage ---
MEDIA_ROOT=media
MAX_UPLOAD_SIZE_MB=15

# --- CORS (for future mobile/API clients) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Security / rate limiting ---
LOGIN_RATE_LIMIT=5/minute
PASSWORD_RESET_RATE_LIMIT=3/hour
STATEMENT_UPLOAD_RATE_LIMIT=10/hour

# --- Error monitoring (optional) ---
SENTRY_DSN=

# --- Currency ---
DEFAULT_CURRENCY=INR
EXCHANGE_RATE_API_KEY=
